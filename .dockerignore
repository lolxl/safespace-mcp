# Keep the Model B build context small + NEVER ship secrets / local state / tests
# into the image. (node_modules is excluded so the multi-stage `bun install`
# result is the only node_modules in the image.)
**/node_modules
.git
.github/
**/*.test.ts
**/*.test.js
coverage/
dist/

# Secrets + local deployment state must never enter the image (they arrive at
# runtime as Compose secrets + a mounted volume).
secrets/
.env
*.local.*

# Docs aren't needed at runtime (entrypoint.sh under deploy/ IS copied explicitly).
docs/
*.md
