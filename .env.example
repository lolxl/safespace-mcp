# SafeSpace MCP — environment variables (v1.67 catalog).
#
# Every variable SafeSpace reads, grouped by parsing idiom. Generated from the
# single catalog in .claude-plugin/src/config.ts — see that file's header for
# why each idiom differs. Copy to `.env` (or export in your shell) and fill in
# only what you need; ALL are optional and default to the SAFE behavior.
#
# SECURITY: this file holds NAMES + prose ONLY — never a real token, email, or
# secret. Tokens are set via the CLI (`safespace line set-token`, etc.), never
# committed here. Allowlist values are intentionally left blank.
#
# Parsing notes:
#   - strict-truthy flags accept the literal lowercase `true` ONLY — any other
#     value (True / 1 / yes / "") reads as OFF (a typo fails toward the safe side).
#   - `*_EXTRA` vars are a SHELL-ONLY overlay: set them per-session in your shell,
#     not in a persisted .env, so an ephemeral allowance can't outlive the session.

# ── OAuth provider APP credentials (NOT in the SAFESPACE_ catalog) ──────────
# These are the OAuth *application* credentials for each OAuth source, read raw
# (no SAFESPACE_ prefix) by the consent flows — they are NOT part of the
# SAFESPACE_ runtime catalog in config.ts. Required only to run `safespace consent`.
#   - Google (Gmail/Drive/Docs/…): a GCP OAuth client. Set both, then
#     `safespace consent <email>`.
#   - GitHub (v1.70): a GitHub OAuth App (Settings → Developer settings → OAuth
#     Apps). The Authorization callback URL is a 127.0.0.1 loopback chosen per-run
#     (any loopback port is accepted by GitHub). Set both, then
#     `safespace consent <login> --provider github`. Scopes requested: read:user
#     + public_repo (minimal; private-repo `repo` is a later re-consent upgrade).
#   - Notion (v1.78): a Notion public integration (notion.so/my-integrations →
#     type "Public"). The redirect URI is a 127.0.0.1 loopback chosen per-run. Set
#     both, then `safespace consent --provider notion` (no positional — the
#     workspace is discovered). Notion OAuth has no scope param (the integration's
#     capabilities are configured Notion-side); single-workspace in v1.
# Prefer exporting these in your shell / secret manager over persisting here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# ── Deployment mode (strict-truthy) ────────────────────────────────────────
# Strict/autonomous mode for unattended agents: flips the recipient / drive-share
# / tasks-delete allowlists to deny-by-default and hard-denies permanent deletes.
SAFESPACE_AUTONOMOUS=
# Company-deployment hardening assertion (v1.86; docs/SOLE-EGRESS.md). When "true",
# the server REFUSES to start unless the SafeSpace-side knobs hold: autonomous mode
# on / non-keyfile token store (keychain or passphrase; the ALLOW_KEYFILE_AT_REST
# hatch is NOT honored here) / HTTP bind ≠ 0.0.0.0. Opt-in; unset = today's posture.
# Report it without starting the server: `safespace doctor --posture`.
SAFESPACE_ENFORCED=

# ── Privilege tier (set-membership: read | write | share; default read) ─────
# Which tools are exposed. Higher = more. Invalid value → falls back to `read`.
SAFESPACE_TIER=

# ── Recipient allowlist (gmail_send / gmail_create_draft / drive_share_file) ─
# Comma-separated emails or @domains. Unset = allow (interactive); set = only
# these. _EXTRA is a shell-only additive overlay.
SAFESPACE_RECIPIENT_ALLOW=
SAFESPACE_RECIPIENT_ALLOW_EXTRA=
# Opt-in name→email contact resolution (strict-truthy). Resolved emails STILL
# pass the allowlist above.
SAFESPACE_RECIPIENT_ALLOW_CONTACTS=

# ── tasks_delete target allowlist (default OFF = allow; opt-in tightening) ───
# Comma-separated `tasklist:<id>` entries. _EXTRA is shell-only.
SAFESPACE_TASKS_DELETE_TARGETS=
SAFESPACE_TASKS_DELETE_TARGETS_EXTRA=

# ── LINE recipient allowlist (line_push_message; default allow / autonomous=deny)
# Comma-separated U…/C…/R… ids (32 hex). _EXTRA is shell-only.
SAFESPACE_LINE_RECIPIENT_ALLOW=
SAFESPACE_LINE_RECIPIENT_ALLOW_EXTRA=

# ── Telegram recipient allowlist (telegram_send_message; default allow / autonomous=deny)
# Comma-separated numeric chat ids (e.g. 123456789, -1001234567890) or @usernames.
# _EXTRA is shell-only.
SAFESPACE_TELEGRAM_RECIPIENT_ALLOW=
SAFESPACE_TELEGRAM_RECIPIENT_ALLOW_EXTRA=

# ── Discord recipient allowlist (discord_send_message; default allow / autonomous=deny)
# Comma-separated numeric channel ids (snowflakes, 17–20 digits). _EXTRA is shell-only.
SAFESPACE_DISCORD_RECIPIENT_ALLOW=
SAFESPACE_DISCORD_RECIPIENT_ALLOW_EXTRA=

# ── YouTube comment target allowlist (PUBLIC surface — default-empty = DENY) ─
# Comma-separated video:/channel:/playlist: entries. _EXTRA is shell-only.
SAFESPACE_YOUTUBE_COMMENT_TARGETS=
SAFESPACE_YOUTUBE_COMMENT_TARGETS_EXTRA=

# ── GitHub WRITE target allowlist (PUBLIC surface — default-empty = DENY) ────
# Comma-separated `owner/repo` entries (case-insensitive). UNSET (both vars) = ALL
# GitHub writes (github_create_issue / _issue_comment / update_issue) are hard-denied
# even with the public_repo scope + write tier. _EXTRA is shell-only (per-session).
# NOTE: this is a deny-default gate, so an explicit list = "allow these" — setting
# _EXTRA ALONE (base unset) DOES enable writes to the repos you listed there (a
# stderr warning fires so you notice the base is unset). To keep ALL writes denied,
# leave BOTH unset.
SAFESPACE_GITHUB_WRITE_TARGETS=
SAFESPACE_GITHUB_WRITE_TARGETS_EXTRA=

# ── GitHub APPROVE target allowlist (default-empty = DENY) ───────────────────
# A SEPARATE list for the APPROVE event of github_create_pull_request_review. An
# APPROVE vouches for a PR and — under branch protection — can UNBLOCK its merge, so
# it is gated on its OWN list (a repo write-allowlisted above is NOT thereby
# approve-allowlisted). COMMENT / REQUEST_CHANGES reviews stay on the WRITE list.
# Same `owner/repo` syntax + two-layer base/_EXTRA. UNSET (both) = no approvals.
SAFESPACE_GITHUB_APPROVE_TARGETS=
SAFESPACE_GITHUB_APPROVE_TARGETS_EXTRA=

# ── web_fetch host allowlist (autonomous + empty = deny-all) ────────────────
# Comma-separated hostnames. _EXTRA is shell-only.
SAFESPACE_WEBFETCH_ALLOW=
SAFESPACE_WEBFETCH_ALLOW_EXTRA=

# ── Outbound secret-shape scan (strict-truthy; default OFF) ─────────────────
# Enables the FP-prone entropy/verification-code rules in the F3a outbound scan.
SAFESPACE_OUTBOUND_SECRET_EXTRA=

# ── YouTube Analytics monetary opt-in (strict-truthy; default OFF) ──────────
# Unlocks revenue metrics + requests the monetary scope at consent.
SAFESPACE_YOUTUBE_ANALYTICS_MONETARY=

# ── Numeric tuning (bad/missing → the documented default) ───────────────────
# Burst caps (calls per rolling 60s window). Defaults: write 60, delete 20.
SAFESPACE_WRITE_BURST_LIMIT=
SAFESPACE_DELETE_BURST_LIMIT=
# YouTube per-session burst caps (range 1-100). Defaults: comment 10, search 20.
SAFESPACE_YOUTUBE_COMMENT_BURST_LIMIT=
SAFESPACE_YOUTUBE_SEARCH_BURST_LIMIT=
# web_fetch response cap (bytes; default 5 MB) and timeout (ms; default 10000).
SAFESPACE_WEBFETCH_MAX_BYTES=
SAFESPACE_WEBFETCH_TIMEOUT_MS=

# ── fs_read root allowlist (v1.75; DEFAULT-DENY — unset = read NOTHING) ──────
# Comma-separated ABSOLUTE directories fs_read may read under. A path is allowed
# only if it resolves — after following symlinks + collapsing `..` — within one of
# these roots (so a symlink inside a root pointing outside it cannot escape). Only
# regular UTF-8 text files ≤ 5 MB are returned. Leave unset to disable fs_read.
SAFESPACE_FS_READ_ROOTS=
# Shell-only per-session overlay (same format).
SAFESPACE_FS_READ_ROOTS_EXTRA=

# ── Storage / identity (raw string + default) ──────────────────────────────
# Config + token-store directory (default ~/.config/safespace).
SAFESPACE_CONFIG_DIR=
# SecretBackend selector: keychain | file (auto: keychain on macOS, file elsewhere).
SAFESPACE_SECRET_BACKEND=
# Operator handle stamped on every audit row (NOT a secret; self-chosen).
SAFESPACE_OPERATOR_ID=

# ── Secret-at-rest hardening ────────────────────────────────────────────────
# Passphrase for the encrypted FileBackend no-key-at-rest mode (presence enables
# it; empty = key-file mode). Prefer exporting in your shell over persisting here.
SAFESPACE_SECRET_PASSPHRASE=
# Escape hatch (strict-truthy): allow FileBackend key-at-rest under autonomous
# mode. Leave unset unless you accept offline-capture risk (see SECURITY.md).
SAFESPACE_ALLOW_KEYFILE_AT_REST=

# ── Service tokens — DO NOT set here ────────────────────────────────────────
# The LINE channel access token resolves env → SecretBackend. Set it with
# `safespace line set-token` (reads stdin, never echoed). An env override is
# possible for CI but must come from your shell/secret manager, never a .env file.
# SAFESPACE_LINE_CHANNEL_TOKEN=  (intentionally left documented-only)
# The Telegram bot token resolves the same way. Set it with
# `safespace telegram set-token` (reads stdin, never echoed). NOTE the token is sent
# as a URL path segment to api.telegram.org — SafeSpace never logs the request URL.
# SAFESPACE_TELEGRAM_BOT_TOKEN=  (intentionally left documented-only)
# The Discord bot token resolves the same way. Set it with
# `safespace discord set-token` (reads stdin, never echoed). It is sent in an
# `Authorization: Bot <token>` header to discord.com (never echoed on error).
# SAFESPACE_DISCORD_BOT_TOKEN=  (intentionally left documented-only)

# ── Model B transport + operator auth (v1.73 PR-1 + v1.74 PR-2b) ────────────
# OPT-IN Streamable HTTP transport for a SHARED multi-operator deployment. DEFAULT
# (unset) = stdio = single-operator Model A = today's behavior — leave ALL of these
# unset for the normal Claude-plugin usage.
#
# ⚠️ SECURITY — read before enabling:
#   - http = Model B = per-connection operator auth is MANDATORY. SAFESPACE_OPERATORS_FILE
#     is REQUIRED; the server refuses to start without a valid registry, and refuses
#     (403, default-deny) any connection whose verified Tailscale identity is not in it.
#   - Auth is by Tailscale WhoIs over the VERIFIED peer IP (non-forgeable) — bind the
#     tailscale interface (a 100.x.y.z address). NEVER 0.0.0.0: that would expose the
#     listener to networks where the peer IP is not a tailnet identity.
#   - Tailscale authenticates the DEVICE, not each request — the envelope (tier,
#     allowlists, burst, audit operator) stays mandatory. Only deploy on a tailnet of
#     mutually-trusting operators.
#   - Per-operator OAuth-account confinement lands in PR-2c; until then do NOT rely on
#     allowedAccounts to isolate cross-account reads.
#
# Selector ∈ {stdio (default), http}. Any other value falls back to stdio.
SAFESPACE_TRANSPORT=
# HTTP listener port (required when SAFESPACE_TRANSPORT=http; integer 1-65535).
SAFESPACE_HTTP_PORT=
# HTTP bind address. Defaults to 127.0.0.1 (loopback). For Model B, bind the
# tailscale interface (100.x.y.z) explicitly. NEVER defaults to 0.0.0.0.
SAFESPACE_HTTP_BIND=
# operators.json registry path (REQUIRED in http mode): maps a verified tailnet
# login → {operatorId, tier, allowedAccounts}. Default-deny on an unlisted login.
# v1.80: the file is HOT-RELOADED — an edit applies on each operator's NEXT
# request (a removed operator's live session 403s; a tier/allowedAccounts change
# takes effect next call). An INVALID edit keeps the last-good registry (the
# server warns on stderr and never falls open); startup still refuses to serve
# on an invalid file.
SAFESPACE_OPERATORS_FILE=
# Override the tailscaled LocalAPI unix socket (default: /run/tailscale/tailscaled.sock).
SAFESPACE_TAILSCALE_SOCKET=

# ── Supervised send-approval + token auth (Model B) ──
# Require human approve/deny (via `safespace send`) before an outbound send. Strict-truthy.
SAFESPACE_REQUIRE_SEND_APPROVAL=
# Path override for the agent-token store used by token auth (default: under the configDir).
SAFESPACE_AGENT_TOKENS_FILE=
# GitHub PR-merge target allowlist (owner/repo, comma-separated; default-deny).
SAFESPACE_GITHUB_MERGE_TARGETS=

# ── Inbound webhook listener (Model B; a separate node:http surface) ──
# Slack Events signing secret used to verify inbound webhook requests.
SAFESPACE_SLACK_WEBHOOK_SECRET=
# Webhook listener port + bind address (default: loopback).
SAFESPACE_WEBHOOK_PORT=
SAFESPACE_WEBHOOK_BIND=
# Attest that an external TLS-terminating proxy fronts the listener (strict-truthy; relaxes
# the enforced-mode all-interfaces bind gate — see docs/DEPLOY.md). SafeSpace cannot verify it.
SAFESPACE_TLS_TERMINATED=

# ── Legacy (removed in v1.1 — kept here only to explain a migration error) ──
# SAFESPACE_ENABLE_SEND / _MODIFY / _DRIVE_SHARE were replaced by SAFESPACE_TIER.
# If a v1.x .env still sets them, run `safespace migrate-v2`. Do not set these.
