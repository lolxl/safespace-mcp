# Copy this file to .env and fill in your Google Cloud OAuth client credentials.
# Create a Desktop-app OAuth 2.0 Client at https://console.cloud.google.com/apis/credentials
# Required for: `bun run consent <email>` (src/auth/consent.ts) and refresh flow (src/auth/refresh.ts).

GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here
